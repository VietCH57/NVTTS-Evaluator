# --- Virtual environments ---
.venv/
venv/
env/

# --- Dataset (large; shared as a private Kaggle Dataset, not through git) ---
data/vinv-tts

# --- Model weights and caches (anchored to the repo root with a leading "/" so that the
#     source package nvtts_eval/models/ is NOT ignored) ---
# hynt/Zipformer-30M-RNNT-6000h is CC BY-NC-ND 4.0: never commit or redistribute it.
/models/
/pretrained_models/
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors
*.joblib
bpe.model
tokens.txt
.cache/
huggingface/

# --- Evaluation outputs: regenerate with `python -m nvtts_eval.cli ...` ---
runs/
evaluation_output/
human_package*/
for_raters*/
# Manifests store absolute paths of the machine that built them (D:/..., /kaggle/...).
# Rebuild them with adapter_vinv instead of committing them.
manifests/*.jsonl

# --- Secrets ---
.env
.env.*
*.token
kaggle.json

# --- Logs and Kaggle output files ---
*.log
__notebook__.ipynb
__results__.html
__results___files/

# --- Notebooks: keep only the cleaned ones under notebooks/ (no outputs) ---
*.ipynb
!notebooks/*.ipynb
.ipynb_checkpoints/

# --- Python bytecode and caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# --- Packaging and build artifacts ---
*.egg-info/
build/
dist/

# --- Coverage and type-checker caches ---
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pyre/
.ruff_cache/

# --- Local editor and OS files ---
.vscode/
.idea/
.DS_Store
Thumbs.db
